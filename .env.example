# Firebase web-app settings (Firebase console -> Project settings -> Your apps -> Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Firebase service-account JSON, base64-encoded
# (Project settings -> Service accounts -> Generate new private key).
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server only. PayPal REST app (developer.paypal.com -> Apps & Credentials). Keep PAYPAL_ENV=sandbox until launch.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=P-xxx
PAYPAL_WEBHOOK_ID=
